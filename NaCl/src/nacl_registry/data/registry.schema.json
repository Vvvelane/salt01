{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NaCl Group 1–4 Registry v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "group": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "required": [
          "path",
          "sha256",
          "group"
        ],
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 4
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family_id": {
            "type": "string",
            "pattern": "^F[A-Z]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "core_mechanism": {
            "type": "string",
            "minLength": 1
          },
          "core_hypothesis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "family_id",
          "name",
          "group",
          "core_mechanism",
          "core_hypothesis"
        ],
        "additionalProperties": false
      },
      "minItems": 11,
      "maxItems": 11
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "factor_id": {
            "type": "string",
            "pattern": "^F[A-Z]{2}[0-9]{3}$"
          },
          "group": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "family": {
            "type": "string",
            "pattern": "^F[A-Z]{2}$"
          },
          "family_name": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "level": {
            "enum": [
              "Primitive",
              "Derived",
              "Composite"
            ]
          },
          "core_mechanism": {
            "type": "string",
            "minLength": 1
          },
          "core_hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "core_scope": {
            "const": "family"
          },
          "idea_summary": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "mathematical_construction": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "observable_data": {
            "type": "string",
            "minLength": 1
          },
          "temporal_structure": {
            "type": "string",
            "minLength": 1
          },
          "lineage": {
            "type": "string",
            "minLength": 1
          },
          "economic_failure_modes": {
            "type": "string",
            "minLength": 1
          },
          "engineering_role": {
            "type": "string",
            "minLength": 1
          },
          "competes_with": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "factor_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^F[A-Z]{2}[0-9]{3}$"
                },
                "uniqueItems": true
              },
              "family_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^F[A-Z]{2}$"
                },
                "uniqueItems": true
              },
              "unresolved_references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "enum": [
                  "not_applicable",
                  "stated",
                  "pending_validation"
                ]
              }
            },
            "required": [
              "text",
              "factor_ids",
              "family_ids",
              "unresolved_references",
              "status"
            ],
            "additionalProperties": false
          },
          "composed_with": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "factor_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^F[A-Z]{2}[0-9]{3}$"
                },
                "uniqueItems": true
              },
              "family_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^F[A-Z]{2}$"
                },
                "uniqueItems": true
              },
              "unresolved_references": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "enum": [
                  "not_applicable",
                  "stated",
                  "pending_validation"
                ]
              }
            },
            "required": [
              "text",
              "factor_ids",
              "family_ids",
              "unresolved_references",
              "status"
            ],
            "additionalProperties": false
          },
          "strategy_translation": {
            "type": "object",
            "properties": {
              "signal_to_position_mapping": {
                "type": "string",
                "minLength": 1
              },
              "strategy_hypotheses": {
                "type": "string",
                "minLength": 1
              },
              "latency_assumption": {
                "type": "string",
                "minLength": 1
              },
              "protective_rules": {
                "type": "string",
                "minLength": 1
              },
              "position_sizing": {
                "type": "string",
                "minLength": 1
              },
              "implementation_risks": {
                "type": "string",
                "minLength": 1
              },
              "backtest_policy_profile": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "signal_to_position_mapping",
              "strategy_hypotheses",
              "latency_assumption",
              "protective_rules",
              "position_sizing",
              "implementation_risks",
              "backtest_policy_profile"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "original_market_frequency_holding": {
                "type": "string",
                "minLength": 1
              },
              "implementability": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "reference",
              "original_market_frequency_holding",
              "implementability"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "file_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "card_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "markdown": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "file_sha256",
              "line_start",
              "line_end",
              "card_sha256",
              "markdown"
            ],
            "additionalProperties": false
          },
          "source_gaps": {
            "type": "array",
            "items": {
              "enum": [
                "mathematical_construction"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "factor_id",
          "group",
          "family",
          "family_name",
          "name",
          "tags",
          "level",
          "core_mechanism",
          "core_hypothesis",
          "core_scope",
          "idea_summary",
          "notes",
          "mathematical_construction",
          "observable_data",
          "temporal_structure",
          "lineage",
          "economic_failure_modes",
          "engineering_role",
          "competes_with",
          "composed_with",
          "strategy_translation",
          "evidence",
          "source",
          "source_gaps"
        ],
        "additionalProperties": false
      },
      "minItems": 58,
      "maxItems": 58
    }
  },
  "required": [
    "schema_version",
    "source_documents",
    "families",
    "cards"
  ],
  "additionalProperties": false
}
